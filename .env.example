# Local dev: copy to .env.local (Next) and .dev.vars (wrangler bindings if needed).
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-chars
# Comma-separated admin emails (case-insensitive)
ADMIN_EMAILS=you@example.com
# In dev, emails are printed to the terminal instead of sent when RESEND_API_KEY is empty
# or MAIL_TRANSPORT=console (ignored in production).
# MAIL_TRANSPORT=console
RESEND_API_KEY=
RESEND_FROM_EMAIL=Subscription Tracker <noreply@example.com>
